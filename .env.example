# MQTT Broker
MQTT_BROKER=localhost
MQTT_PORT=1883

# Database
DATABASE_URL=postgresql://edgeeye:edgeeye@localhost:5432/edgeeye

# Edge device settings
DEVICE_ID=cam-01
IMAGE_DIR=sample_images
DETECTION_INTERVAL=5

# Confidence threshold for YOLO detections.
# Only detections with a confidence score >= this value will be published.
# Must be a float between 0.0 and 1.0 (inclusive).
# Lower values detect more objects but with more false positives.
# Higher values are more precise but may miss real detections.
CONFIDENCE_THRESHOLD=0.5
